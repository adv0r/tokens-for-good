#!/usr/bin/env python3
"""tfg — Tokens for good CLI.

The single user-facing entry point for the Tokens for good initiative.
Reads/writes:
  - public framework files (this repo)
  - local state in ~/.local/share/tokens-for-good/

Subcommands:
  init              create local state dir + init state.db from schema
  refresh           pull latest PR state from gh and update state.db
  stats             print dashboard numbers (helpful-signal-rate primary)
  stats --update-readme
                    rewrite the STATS_START/STATS_END block in README.md
  vet <repo>        check if a repo is open (NOT blacklisted, NOT in cooldown)
  triage            sweep all open PRs (placeholder: prints checklist)
  followup          PRs whose next_checkpoint_at <= now (placeholder)
  session           orchestrator: prints next-action hints (interactive default)
  session --auto    same, but autonomous mode for launchd
  session --confirm same, confirmed mode (default)
  lessons list      list lessons by status
  lessons render    regenerate kb/lessons.md from kb/lessons.yaml
  policy render     regenerate kb/repos-policy.md from kb/repos-policy.yaml
  pr-history render regenerate kb/pr-history.md from state.db
  pages-build       regenerate docs/dashboard/data.json from state.db
  version           print version
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.1.0"

REPO_ROOT = Path(__file__).resolve().parent.parent
LOCAL_DIR = Path.home() / ".local" / "share" / "tokens-for-good"
DB_PATH = LOCAL_DIR / "state.db"
USER_STATE_PATH = LOCAL_DIR / "user-state.json"
SCHEMA_PATH = REPO_ROOT / "schema" / "state.sql"

# Initiative kickoff date. PRs created on or after this are considered cohort.
INITIATIVE_START = "2026-05-15"


# ---- helpers --------------------------------------------------------------

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_yaml(path: Path):
    try:
        import yaml  # type: ignore
    except ImportError:
        sys.exit("error: PyYAML required. Install with: pip3 install pyyaml")
    with path.open() as f:
        return yaml.safe_load(f)


def db_connect() -> sqlite3.Connection:
    if not DB_PATH.exists():
        sys.exit(
            f"error: state.db not found at {DB_PATH}\n"
            "  Run `tfg init` first."
        )
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def gh_search_prs():
    """Return list of PRs from gh search, or [] on failure."""
    try:
        result = subprocess.run(
            [
                "gh", "search", "prs",
                "--author", "@me",
                "--created", f">={INITIATIVE_START}",
                "--limit", "200",
                "--json", "url,title,repository,state,createdAt,closedAt,isDraft",
            ],
            capture_output=True, text=True, check=True,
        )
        return json.loads(result.stdout)
    except FileNotFoundError:
        sys.exit("error: gh CLI not found in PATH")
    except subprocess.CalledProcessError as e:
        sys.exit(f"error: gh search failed: {e.stderr.strip()}")


# ---- subcommand: init -----------------------------------------------------

def cmd_init(args):
    LOCAL_DIR.mkdir(parents=True, exist_ok=True)
    (LOCAL_DIR / "logs").mkdir(exist_ok=True)

    if not SCHEMA_PATH.exists():
        sys.exit(f"error: schema file not found at {SCHEMA_PATH}")

    fresh = not DB_PATH.exists()
    conn = sqlite3.connect(DB_PATH)
    with SCHEMA_PATH.open() as f:
        conn.executescript(f.read())
    conn.commit()

    # Seed config row.
    conn.execute(
        "INSERT OR REPLACE INTO config(key, value) VALUES ('initiative_start', ?)",
        (INITIATIVE_START,),
    )
    conn.execute(
        "INSERT OR REPLACE INTO config(key, value) VALUES ('schema_version', '1')",
    )
    conn.commit()
    conn.close()

    if not USER_STATE_PATH.exists():
        USER_STATE_PATH.write_text(json.dumps({
            "_schema_version": 1,
            "github_handle": "adv0r",
            "languages": ["en"],
            "session_defaults": {"mode": "confirmed", "round_size": 10}
        }, indent=2) + "\n")

    print(f"{'created' if fresh else 'updated'} state.db at {DB_PATH}")
    print(f"local state dir:  {LOCAL_DIR}")


# ---- subcommand: refresh --------------------------------------------------

def cmd_refresh(args):
    """Pull current PR data from gh and upsert into state.db."""
    if not DB_PATH.exists():
        cmd_init(args)

    prs = gh_search_prs()
    conn = db_connect()
    cur = conn.cursor()

    upserts = 0
    state_changes = 0
    for p in prs:
        url = p["url"]
        repo = p["repository"]["nameWithOwner"]
        pr_number = int(url.rsplit("/", 1)[-1])
        state = "draft" if (p["state"] == "open" and p["isDraft"]) else p["state"]
        title = p["title"]
        opened_at = p["createdAt"]

        # Helpful signal: merged → +1; closed → -1; open/draft → NULL until decided.
        if p["state"] == "merged":
            helpful = 1
        elif p["state"] == "closed":
            helpful = -1
        else:
            helpful = None

        # Try to match against existing.
        existing = cur.execute(
            "SELECT id, state, helpful_signal FROM prs WHERE url = ?", (url,)
        ).fetchone()

        if existing is None:
            cur.execute(
                """
                INSERT INTO prs (
                  url, repo, pr_number, contribution_type, title,
                  opened_at, state, last_checked_at, helpful_signal
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    url, repo, pr_number,
                    "unknown",  # contribution_type — refined later by tb-self-improve
                    title, opened_at, state, now_iso(), helpful,
                ),
            )
            upserts += 1
            cur.execute(
                "INSERT INTO events (ts, skill, kind, pr_id, payload_json) "
                "VALUES (?, 'tfg-refresh', 'pr_observed', ?, ?)",
                (now_iso(), cur.lastrowid, json.dumps({"state": state})),
            )
        else:
            if existing["state"] != state or existing["helpful_signal"] != helpful:
                cur.execute(
                    "UPDATE prs SET state = ?, helpful_signal = ?, last_checked_at = ? "
                    "WHERE id = ?",
                    (state, helpful, now_iso(), existing["id"]),
                )
                state_changes += 1
                cur.execute(
                    "INSERT INTO events (ts, skill, kind, pr_id, payload_json) "
                    "VALUES (?, 'tfg-refresh', 'pr_state_changed', ?, ?)",
                    (
                        now_iso(),
                        existing["id"],
                        json.dumps({
                            "from": existing["state"],
                            "to": state,
                        }),
                    ),
                )
            else:
                cur.execute(
                    "UPDATE prs SET last_checked_at = ? WHERE id = ?",
                    (now_iso(), existing["id"]),
                )

    conn.commit()
    conn.close()
    print(f"refresh: {upserts} new PR(s), {state_changes} state change(s), "
          f"{len(prs)} total in cohort")


# ---- subcommand: stats ----------------------------------------------------

def _dashboard_row(conn) -> dict:
    row = conn.execute("SELECT * FROM v_dashboard").fetchone()
    if row is None:
        return {
            "total_prs": 0, "merged": 0, "closed_unmerged": 0,
            "still_open": 0, "unique_repos": 0,
            "helpful_count": 0, "unhelpful_count": 0,
            "helpful_signal_rate": None,
        }
    return dict(row)


def _format_stats_block(d: dict, ts: str) -> str:
    rate = d["helpful_signal_rate"]
    if rate is None:
        rate_display = "n/a (no decided PRs yet)"
    else:
        decided = (d["helpful_count"] or 0) + (d["unhelpful_count"] or 0)
        rate_display = f"{round(rate * 100)}% ({d['helpful_count']}/{decided} decided)"

    open_count = d["still_open"] or 0
    body = (
        "| Metric | Value |\n"
        "|---|---|\n"
        f"| **Helpful-signal rate** (primary) | **{rate_display}** |\n"
        f"| PRs opened (since {INITIATIVE_START}) | **{d['total_prs']}** |\n"
        f"| PRs merged | **{d['merged']}** |\n"
        f"| PRs closed (no merge) | **{d['closed_unmerged']}** |\n"
        f"| PRs still open | **{open_count}** |\n"
        f"| Unique repos touched | **{d['unique_repos']}** |\n"
        f"| Cursor tokens used (this billing cycle) | _~XX% of monthly budget — manually updated_ |"
    )
    return (
        "<!-- STATS_START -->\n"
        f"_Last refreshed: {ts} (UTC). Auto-generated by `tfg stats --update-readme`._\n\n"
        f"{body}\n"
        "<!-- STATS_END -->"
    )


def _top_friendly_repos(conn, limit=5):
    try:
        rows = conn.execute(
            "SELECT repo, contribution_type, score, positive_count, last_positive_at "
            "FROM v_friendly_targets LIMIT ?", (limit,)
        ).fetchall()
        return [dict(r) for r in rows]
    except sqlite3.OperationalError:
        return []


def _model_breakdown(conn):
    """Return [{model, n, merged, n_decided, thanked}] for non-NULL models."""
    try:
        rows = conn.execute(
            """
            SELECT
              COALESCE(model, '(unknown)') AS model,
              COUNT(*) AS n,
              SUM(CASE WHEN state = 'merged' THEN 1 ELSE 0 END) AS merged,
              SUM(CASE WHEN state IN ('merged','closed') THEN 1 ELSE 0 END) AS n_decided
            FROM prs
            GROUP BY COALESCE(model, '(unknown)')
            ORDER BY n DESC
            """
        ).fetchall()
    except sqlite3.OperationalError:
        return []
    out = []
    for r in rows:
        thanked = conn.execute(
            "SELECT COUNT(*) FROM events e JOIN prs p ON e.pr_id = p.id "
            "WHERE e.kind = 'thanks_replied' "
            "AND COALESCE(p.model, '(unknown)') = ?",
            (r["model"],),
        ).fetchone()[0]
        out.append({
            "model": r["model"], "n": r["n"], "merged": r["merged"],
            "n_decided": r["n_decided"], "thanked": thanked,
        })
    return out


def _optouts_stats(conn):
    """Count explicit opt-outs honored and time-to-honor in seconds."""
    try:
        rows = conn.execute(
            "SELECT ts, payload_json FROM events WHERE kind = 'explicit_optout' "
            "ORDER BY ts DESC"
        ).fetchall()
    except sqlite3.OperationalError:
        return {"count": 0, "avg_seconds": None, "most_recent": None}
    if not rows:
        return {"count": 0, "avg_seconds": None, "most_recent": None}
    deltas = []
    for r in rows:
        try:
            payload = json.loads(r["payload_json"] or "{}")
            dt = payload.get("response_time_seconds")
            if isinstance(dt, (int, float)):
                deltas.append(dt)
        except json.JSONDecodeError:
            pass
    avg = sum(deltas) / len(deltas) if deltas else None
    payload = {}
    try:
        payload = json.loads(rows[0]["payload_json"] or "{}")
    except json.JSONDecodeError:
        pass
    return {
        "count": len(rows),
        "avg_seconds": avg,
        "most_recent": {
            "repo": payload.get("repo"),
            "at": rows[0]["ts"],
        },
    }


def _emerging_patterns(conn, min_citations=2):
    """Read lesson_candidate events; aggregate by title."""
    try:
        rows = conn.execute(
            "SELECT payload_json FROM events WHERE kind = 'lesson_candidate'"
        ).fetchall()
    except sqlite3.OperationalError:
        return []
    buckets: dict[str, list[str]] = {}
    for r in rows:
        try:
            p = json.loads(r["payload_json"] or "{}")
        except json.JSONDecodeError:
            continue
        title = p.get("title")
        if title:
            buckets.setdefault(title, []).append(p.get("source", ""))
    return [
        {"title": t, "citations": len(srcs), "sources": srcs}
        for t, srcs in buckets.items()
        if len(srcs) >= min_citations
    ]


def cmd_stats(args):
    conn = db_connect()
    d = _dashboard_row(conn)
    rate = d["helpful_signal_rate"]
    rate_display = "n/a" if rate is None else f"{rate * 100:.0f}%"

    print(f"Tokens for good — dashboard ({now_iso()})")
    print(f"  Helpful-signal rate (primary): {rate_display}")
    print(f"  Total PRs:        {d['total_prs']}")
    print(f"  Merged:           {d['merged']}")
    print(f"  Closed unmerged:  {d['closed_unmerged']}")
    print(f"  Still open:       {d['still_open']}")
    print(f"  Unique repos:     {d['unique_repos']}")
    print(f"  Helpful (+):      {d['helpful_count']}")
    print(f"  Unhelpful (-):    {d['unhelpful_count']}")

    # PRs by model (v2.1)
    mods = _model_breakdown(conn)
    if mods:
        print()
        print("PRs BY MODEL (current cycle):")
        for m in mods:
            mr = (
                f"{round(100 * (m['merged'] or 0) / m['n_decided'])}%"
                if m['n_decided'] else "n/a"
            )
            print(
                f"  {m['model']:24}  {m['n']:3}   "
                f"merge rate: {mr:<5}   thanked: {m['thanked']}"
            )

    # Top friendly repos (v2.1)
    fr = _top_friendly_repos(conn, limit=5)
    if fr:
        print()
        print("TOP 5 FRIENDLY REPOS (by affinity score):")
        for f in fr:
            print(
                f"  {f['repo']:30}  score={f['score']:.1f}   "
                f"({f['positive_count']} positive · last {f['last_positive_at'] or '—'})"
            )

    # Emerging patterns (v2.1)
    ep = _emerging_patterns(conn)
    if ep:
        print()
        print("EMERGING PATTERNS (lesson candidates, N≥2):")
        for e in ep:
            srcs = ", ".join(s for s in e["sources"] if s)
            print(f"  {e['title']}")
            print(f"    citations: {e['citations']}  ({srcs})")

    # Opt-outs (v2.1)
    oo = _optouts_stats(conn)
    print()
    print(f"EXPLICIT OPT-OUTS HONORED: {oo['count']}")
    if oo["count"]:
        if oo["avg_seconds"] is not None:
            mins = oo["avg_seconds"] / 60.0
            print(f"  avg time-to-honor: {mins:.1f} minutes")
        if oo["most_recent"] and oo["most_recent"]["repo"]:
            print(
                f"  most recent: {oo['most_recent']['repo']} "
                f"on {oo['most_recent']['at'][:10]}"
            )

    if args.update_readme:
        readme = REPO_ROOT / "README.md"
        if not readme.exists():
            sys.exit(f"error: README.md not found at {readme}")
        text = readme.read_text(encoding="utf-8")
        pattern = re.compile(r"<!-- STATS_START -->.*?<!-- STATS_END -->", re.DOTALL)
        m = pattern.search(text)
        if not m:
            sys.exit("error: STATS markers not found in README.md")

        # Idempotency: keep the previous timestamp if the body is unchanged.
        prev_block = m.group(0)
        prev_ts_match = re.search(r"_Last refreshed: ([^\s]+)", prev_block)
        ts = now_iso()
        candidate_block = _format_stats_block(d, ts)

        # Compare bodies (strip timestamp lines)
        def _body(s: str) -> str:
            return re.sub(r"_Last refreshed:[^\n]*\n", "", s)

        if prev_ts_match and _body(prev_block) == _body(candidate_block):
            ts = prev_ts_match.group(1)
            candidate_block = _format_stats_block(d, ts)

        new_text = pattern.sub(candidate_block, text)
        if new_text != text:
            readme.write_text(new_text, encoding="utf-8")
            print(f"updated {readme}")
        else:
            print("README.md already up to date")

    conn.close()


# ---- subcommand: vet ------------------------------------------------------

def _load_policy() -> list[dict]:
    path = REPO_ROOT / "kb" / "repos-policy.yaml"
    data = load_yaml(path) or {}
    return data.get("policies", []) or []


def _match_repo(target: str, pattern: str) -> bool:
    """Match jupyter/notebook against jupyter/* etc."""
    if pattern == target:
        return True
    if pattern.endswith("/*"):
        org = pattern[:-2]
        return target.startswith(org + "/")
    return False


def cmd_vet(args):
    repo = args.repo
    policies = _load_policy()
    matches = [p for p in policies if _match_repo(repo, p["repo"])]

    blacklist = [p for p in matches if p["category"] == "blacklist"]
    friendly = [p for p in matches if p["category"] == "friendly"]

    if blacklist:
        worst = max(
            blacklist,
            key=lambda p: 2 if p.get("severity") == "HARD"
                          else 1 if p.get("severity") == "SOFT" else 0,
        )
        print(f"BLACKLISTED — would not open PR")
        print(f"  matched policy: {worst['repo']} ({worst['severity']})")
        print(f"  signal: {worst['signal_type']}  date: {worst['date']}")
        if worst.get("quote"):
            print(f"  quote: \"{worst['quote']}\"")
        if worst.get("notes"):
            print(f"  notes: {worst['notes']}")
        sys.exit(2)

    if friendly:
        f = friendly[0]
        print(f"OK — friendly")
        print(f"  matched policy: {f['repo']}")
        if f.get("notes"):
            print(f"  notes: {f['notes']}")
        return

    print(f"OK — neutral (no policy match)")
    print(f"  reminder: stick to TIER 1 contribution types and probe_cap=1 for cold repos")


# ---- subcommand: triage ---------------------------------------------------

def cmd_triage(args):
    """On-demand sweep across open PRs. Stub for now — prints a checklist."""
    conn = db_connect()
    rows = conn.execute(
        "SELECT url, repo, state, opened_at FROM prs "
        "WHERE state IN ('open', 'draft') ORDER BY opened_at"
    ).fetchall()
    if not rows:
        print("triage: no open PRs in state.db (try `tfg refresh` first)")
        return
    print(f"triage: {len(rows)} open PR(s) — review each manually for now:")
    for r in rows:
        print(f"  {r['state']:6}  {r['repo']:40}  {r['url']}")
    print()
    print("Next: read skills/tb-triage/SKILL.md and apply per-PR.")
    conn.close()


# ---- subcommand: followup -------------------------------------------------

def cmd_followup(args):
    conn = db_connect()
    now = now_iso()
    rows = conn.execute(
        "SELECT url, repo, state, opened_at, next_checkpoint_at FROM prs "
        "WHERE next_checkpoint_at IS NOT NULL "
        "AND next_checkpoint_at <= ? "
        "AND state IN ('open', 'draft')",
        (now,),
    ).fetchall()
    if not rows:
        print("followup: no PRs at checkpoint yet")
        return
    print(f"followup: {len(rows)} PR(s) due for checkpoint:")
    for r in rows:
        print(f"  {r['state']:6}  {r['repo']:40}  {r['url']}")
    print()
    print("Next: read skills/tb-pr-followup/SKILL.md and apply per-PR.")
    conn.close()


# ---- subcommand: session --------------------------------------------------

def cmd_session(args):
    mode = "auto" if args.auto else "interactive" if args.interactive else "confirmed"
    print(f"tb-session — mode={mode}")
    print()
    print("Read skills/tb-session/SKILL.md for the orchestrator workflow.")
    print()
    print("Suggested next actions:")
    print("  1. tfg refresh                   # pull latest PR state from gh")
    print("  2. tfg stats                     # see helpful-signal rate")
    print("  3. tfg followup                  # check scheduled per-PR checkpoints")
    print("  4. tfg triage                    # sweep open PRs for new activity")
    print("  5. (read kb/contribution-types.yaml; pick a tier-1 type for a friendly repo)")


# ---- subcommand: lessons --------------------------------------------------

def cmd_lessons_list(args):
    data = load_yaml(REPO_ROOT / "kb" / "lessons.yaml") or {}
    lessons = data.get("lessons", []) or []
    by_status: dict[str, list] = {}
    for l in lessons:
        by_status.setdefault(l["status"], []).append(l)
    for status in ("confirmed", "active", "candidate", "retired"):
        items = by_status.get(status, [])
        if not items:
            continue
        print(f"== {status.upper()} ({len(items)}) ==")
        for l in items:
            print(f"  {l['id']:6}  [{l['confidence']:6}]  {l['title']}")


def cmd_lessons_render(args):
    data = load_yaml(REPO_ROOT / "kb" / "lessons.yaml") or {}
    lessons = data.get("lessons", []) or []
    out = REPO_ROOT / "kb" / "lessons.md"
    lines = [
        "# Lessons learned",
        "",
        "_This file is auto-generated from `kb/lessons.yaml` by `tfg lessons render`._",
        "_Edit the YAML and re-render. Direct edits to this file will be overwritten._",
        "",
        "Confidence: **LOW** = 1 data point | **MEDIUM** = 2–3 | **HIGH** = 4+",
        "Status: **candidate** → **active** → **confirmed** → **retired**",
        "",
    ]
    for l in lessons:
        lines.append(f"## {l['id']} — {l['title']}")
        lines.append("")
        lines.append(l["body"].rstrip())
        lines.append("")
        lines.append(f"- **Status**: `{l['status']}`")
        lines.append(f"- **Confidence**: `{l['confidence']}`")
        lines.append(f"- **Created**: {l['created_at']}")
        if l.get("retired_at"):
            lines.append(f"- **Retired**: {l['retired_at']} — {l.get('retired_reason')}")
        if l.get("sources"):
            lines.append("- **Sources**:")
            for s in l["sources"]:
                lines.append(f"  - {s}")
        lines.append(f"- **Rule**:")
        for line in l["rule"].rstrip().splitlines():
            lines.append(f"  > {line}")
        lines.append("")
    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"rendered {out}")


# ---- subcommand: policy ---------------------------------------------------

def cmd_policy_render(args):
    data = load_yaml(REPO_ROOT / "kb" / "repos-policy.yaml") or {}
    policies = data.get("policies", []) or []
    out = REPO_ROOT / "kb" / "repos-policy.md"

    by_cat: dict[str, list] = {}
    for p in policies:
        by_cat.setdefault(p["category"], []).append(p)

    lines = [
        "# Repository policy",
        "",
        "_This file is auto-generated from `kb/repos-policy.yaml` by_",
        "_`tfg policy render`. Edit the YAML and re-render._",
        "",
        "Maintainer handles are anonymized as `maintainer-A`, `maintainer-B`, …",
        "All quotes are verbatim from public PR threads.",
        "",
    ]

    def _section(title: str, items: list, severity_filter=None):
        rows = items if severity_filter is None else [
            x for x in items if x.get("severity") == severity_filter
        ]
        if not rows:
            return
        lines.append(f"## {title}")
        lines.append("")
        lines.append("| Repo / Org | Date | Maintainer | Signal | Quote | Cooldown |")
        lines.append("|---|---|---|---|---|---|")
        for r in rows:
            quote = r.get("quote") or ""
            quote_md = f'"{quote}"' if quote else "_(silent)_"
            mid = r.get("maintainer_id") or "—"
            lines.append(
                f"| `{r['repo']}` | {r['date']} | {mid} | {r['signal_type']} | "
                f"{quote_md} | {r['cooldown_days']}d |"
            )
        lines.append("")

    _section("Blacklist (HARD)", by_cat.get("blacklist", []), "HARD")
    _section("Blacklist (SOFT)", by_cat.get("blacklist", []), "SOFT")
    _section("Friendly", by_cat.get("friendly", []))
    _section("Untested (do-not-try)", by_cat.get("untested", []))

    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"rendered {out}")


# ---- subcommand: pr-history -----------------------------------------------

def cmd_pr_history_render(args):
    conn = db_connect()
    rows = conn.execute(
        "SELECT url, repo, pr_number, title, state, opened_at "
        "FROM prs ORDER BY opened_at DESC"
    ).fetchall()

    out = REPO_ROOT / "kb" / "pr-history.md"
    lines = [
        "# PR history",
        "",
        f"Every PR opened by @adv0r since the Tokens for good initiative began (`{INITIATIVE_START}`).",
        "Auto-rebuilt by `tfg pr-history render` — manual edits will be overwritten.",
        "",
        f"**Total PRs**: {len(rows)}",
        "",
    ]
    if rows:
        merged = sum(1 for r in rows if r["state"] == "merged")
        closed = sum(1 for r in rows if r["state"] == "closed")
        opened_count = sum(1 for r in rows if r["state"] in ("open", "draft"))
        draft = sum(1 for r in rows if r["state"] == "draft")
        lines.append(f"- Merged: {merged}")
        lines.append(f"- Closed (no merge): {closed}")
        lines.append(f"- Open: {opened_count} ({draft} draft)")
        lines.append("")

    lines.append("| PR | Repo | Title | State | Opened |")
    lines.append("|---|---|---|---|---|")
    for r in rows:
        title = r["title"].replace("|", "\\|") if r["title"] else ""
        opened = (r["opened_at"] or "").split("T")[0]
        lines.append(
            f"| [#{r['pr_number']}]({r['url']}) | `{r['repo']}` | {title} | "
            f"{r['state']} | {opened} |"
        )

    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"rendered {out}")
    conn.close()


# ---- subcommand: pages-build ----------------------------------------------

def _by_org(conn, limit=10):
    """Per-org PR counts + helpful-signal rate, top N by total."""
    try:
        rows = conn.execute(
            """
            SELECT
              substr(repo, 1, instr(repo, '/') - 1) AS org,
              COUNT(*) AS n,
              SUM(CASE WHEN state = 'merged' THEN 1 ELSE 0 END) AS merged,
              SUM(CASE WHEN state = 'closed' THEN 1 ELSE 0 END) AS closed,
              SUM(CASE WHEN state IN ('open','draft') THEN 1 ELSE 0 END) AS open,
              SUM(CASE WHEN state IN ('merged','closed') THEN 1 ELSE 0 END) AS decided,
              SUM(CASE WHEN helpful_signal > 0 THEN 1 ELSE 0 END) AS helpful
            FROM prs
            WHERE repo LIKE '%/%'
            GROUP BY org
            ORDER BY n DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()
    except sqlite3.OperationalError:
        return []
    out = []
    for r in rows:
        helpful_rate = (r["helpful"] / r["decided"]) if r["decided"] else None
        out.append({
            "org": r["org"],
            "n": r["n"],
            "merged": r["merged"] or 0,
            "closed": r["closed"] or 0,
            "open": r["open"] or 0,
            "decided": r["decided"] or 0,
            "helpful_rate": helpful_rate,
        })
    return out


def _pr_timeline(conn):
    """Per-day opened/merged counts since INITIATIVE_START for cumulative chart."""
    try:
        rows = conn.execute(
            """
            SELECT
              date(opened_at) AS day,
              COUNT(*) AS opened,
              SUM(CASE WHEN state = 'merged' THEN 1 ELSE 0 END) AS merged
            FROM prs
            WHERE opened_at >= ?
            GROUP BY day
            ORDER BY day
            """,
            (INITIATIVE_START,),
        ).fetchall()
    except sqlite3.OperationalError:
        return []
    return [
        {"day": r["day"], "opened": r["opened"] or 0, "merged": r["merged"] or 0}
        for r in rows
    ]


def cmd_pages_build(args):
    """Regenerate docs/dashboard/data.json from state.db for GitHub Pages."""
    conn = db_connect()
    d = _dashboard_row(conn)
    mods = _model_breakdown(conn)
    fr = _top_friendly_repos(conn, limit=10)
    oo = _optouts_stats(conn)
    ep = _emerging_patterns(conn)
    by_org = _by_org(conn, limit=10)
    pr_timeline = _pr_timeline(conn)

    # By contribution type, stacked by state.
    try:
        rows = conn.execute(
            "SELECT contribution_type, state, COUNT(*) AS n "
            "FROM prs GROUP BY contribution_type, state"
        ).fetchall()
    except sqlite3.OperationalError:
        rows = []
    by_type: dict[str, dict] = {}
    for r in rows:
        bt = by_type.setdefault(r["contribution_type"] or "unknown",
                                {"merged": 0, "closed": 0, "open": 0, "draft": 0})
        if r["state"] in bt:
            bt[r["state"]] = r["n"]

    # Merge-rate trend by ISO week (limit to cohort window).
    try:
        rows = conn.execute(
            """
            SELECT
              strftime('%Y-W%W', opened_at) AS week,
              SUM(CASE WHEN state = 'merged' THEN 1 ELSE 0 END) AS merged,
              SUM(CASE WHEN state IN ('merged','closed') THEN 1 ELSE 0 END) AS decided,
              COUNT(*) AS total
            FROM prs
            WHERE opened_at >= ?
            GROUP BY week
            ORDER BY week
            """,
            (INITIATIVE_START,),
        ).fetchall()
    except sqlite3.OperationalError:
        rows = []
    merge_rate_by_week = []
    for r in rows:
        rate = (r["merged"] / r["decided"]) if r["decided"] else None
        merge_rate_by_week.append({
            "week": r["week"],
            "merged": r["merged"],
            "decided": r["decided"],
            "total": r["total"],
            "merge_rate": rate,
        })

    # commit_sha: short SHA of HEAD if we're in a git checkout (best-effort).
    commit_sha = None
    try:
        commit_sha = subprocess.check_output(
            ["git", "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"],
            stderr=subprocess.DEVNULL,
        ).decode().strip() or None
    except (subprocess.CalledProcessError, FileNotFoundError):
        commit_sha = None

    data = {
        # schema 2 adds: by_org, pr_timeline, commit_sha. schema 1 fields preserved.
        "schema": 2,
        "generated_at": now_iso(),
        "commit_sha": commit_sha,
        "kpi": {
            "total_prs": d["total_prs"] or 0,
            "merged": d["merged"] or 0,
            "closed_unmerged": d["closed_unmerged"] or 0,
            "still_open": d["still_open"] or 0,
            "unique_repos": d["unique_repos"] or 0,
            "helpful_signal_rate": d["helpful_signal_rate"],
            "helpful_count": d["helpful_count"] or 0,
            "unhelpful_count": d["unhelpful_count"] or 0,
        },
        "by_model": mods,
        "by_type": [
            {"contribution_type": k, **v}
            for k, v in sorted(by_type.items(), key=lambda kv: -sum(kv[1].values()))
        ],
        "by_org": by_org,
        "pr_timeline": pr_timeline,
        "merge_rate_by_week": merge_rate_by_week,
        "top_friendly": fr,
        "emerging_patterns": ep,
        "opt_outs": oo,
        "initiative_start": INITIATIVE_START,
    }

    out_dir = REPO_ROOT / "docs" / "dashboard"
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / "data.json"
    out.write_text(json.dumps(data, indent=2, default=str) + "\n", encoding="utf-8")
    conn.close()
    print(f"wrote {out}")


# ---- argparse wiring ------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tfg",
        description="Tokens for good CLI — manage state, vet repos, refresh stats.",
    )
    parser.add_argument("--version", action="version", version=f"tfg {VERSION}")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("init", help="create local state dir + state.db").set_defaults(
        func=cmd_init)
    sub.add_parser("refresh", help="pull latest PR state from gh").set_defaults(
        func=cmd_refresh)

    s_stats = sub.add_parser("stats", help="print dashboard numbers")
    s_stats.add_argument("--update-readme", action="store_true",
                         help="rewrite the STATS block in README.md")
    s_stats.set_defaults(func=cmd_stats)

    s_vet = sub.add_parser("vet", help="check if a repo is open")
    s_vet.add_argument("repo", help="org/name (e.g. astropy/astropy)")
    s_vet.set_defaults(func=cmd_vet)

    sub.add_parser("triage", help="on-demand sweep of open PRs").set_defaults(
        func=cmd_triage)
    sub.add_parser("followup", help="PRs at scheduled checkpoint").set_defaults(
        func=cmd_followup)

    s_session = sub.add_parser("session", help="orchestrator")
    s_session.add_argument("--auto", action="store_true",
                           help="autonomous mode (for launchd)")
    s_session.add_argument("--interactive", action="store_true",
                           help="interactive mode (asks each step)")
    s_session.add_argument("--confirm", action="store_true",
                           help="confirmed mode (default)")
    s_session.set_defaults(func=cmd_session)

    s_lessons = sub.add_parser("lessons", help="lessons CRUD")
    sub_l = s_lessons.add_subparsers(dest="lessons_cmd")
    sub_l.add_parser("list").set_defaults(func=cmd_lessons_list)
    sub_l.add_parser("render").set_defaults(func=cmd_lessons_render)

    s_policy = sub.add_parser("policy", help="policy CRUD")
    sub_p = s_policy.add_subparsers(dest="policy_cmd")
    sub_p.add_parser("render").set_defaults(func=cmd_policy_render)

    s_hist = sub.add_parser("pr-history", help="PR history CRUD")
    sub_h = s_hist.add_subparsers(dest="hist_cmd")
    sub_h.add_parser("render").set_defaults(func=cmd_pr_history_render)

    sub.add_parser("pages-build",
                   help="regenerate docs/dashboard/data.json from state.db"
                   ).set_defaults(func=cmd_pages_build)

    sub.add_parser("version", help="print version").set_defaults(
        func=lambda a: print(f"tfg {VERSION}"))

    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
